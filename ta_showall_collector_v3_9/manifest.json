{
  "manifest_version": 3,
  "name": "TA Show-All Collector",
  "version": "3.9.0",
  "description": "Single Update queue with versioned image requests and separate Trophy Case sync.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://img.trueachievements.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
